<Project Sdk="Microsoft.NET.Sdk">

  <!-- P17: tests for DatabaseManager, ScadaMonitor and the reading sources. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Native SQLite 2.1.11 has a known vulnerability (CVE-2025-6965), so use the fixed version -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <!-- Compile the real classes from the HCRMS project (no WinForms code). -->
  <ItemGroup>
    <Compile Include="../HCRMS/Models/*.cs" LinkBase="Models" />
    <Compile Include="../HCRMS/Data/*.cs" LinkBase="Data" />
    <Compile Include="../HCRMS/Core/RoomFactory.cs" Link="Core/RoomFactory.cs" />
    <Compile Include="../HCRMS/Core/SensorAlert.cs" Link="Core/SensorAlert.cs" />
    <Compile Include="../HCRMS/Core/ScadaMonitor.cs" Link="Core/ScadaMonitor.cs" />
  </ItemGroup>

</Project>
